# Context Bridge Test Environment Configuration

# ============================================================================
# Database Configuration (Test)
# ============================================================================
# PostgreSQL connection settings (used by config.py)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=test_context_bridge
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password

# Connection pool settings (smaller for tests)
DB_POOL_MIN=1
DB_POOL_MAX=5

# Legacy Docker Compose variables (for compatibility)
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DB=test_context_bridge
POSTGRES_PORT=5432

# ============================================================================
# Ollama Configuration
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest
VECTOR_DIMENSION=768

# ============================================================================
# Search Configuration
# ============================================================================
SIMILARITY_THRESHOLD=0.7
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# ============================================================================
# Crawling Configuration (Test)
# ============================================================================
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=50
CRAWL_TIMEOUT=10.0
CRAWL_MAX_CONCURRENT=3
CRAWL_USER_AGENT=ContextBridge-Test/0.1.0
CRAWL_RETRY_ATTEMPTS=2

# ============================================================================
# UI Configuration (Test)
# ============================================================================
UI_HOST=localhost
UI_PORT=8502
UI_THEME=light
UI_ENABLE_METRICS=false

# ============================================================================
# MCP Server Configuration (Test)
# ============================================================================
MCP_SERVER_NAME=context_bridge_test
MCP_HOST=localhost
MCP_PORT=3001
MCP_TRANSPORT=stdio
MCP_LOG_LEVEL=debug

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=json
