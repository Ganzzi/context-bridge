# Context Bridge Environment Configu# ============================================================================
# Search Configuration
# ============================================================================ this file to .env and customize for your environment

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection settings (used by config.py)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=context_bridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Connection pool settings
DB_POOL_MAX=10

# ============================================================================
# Ollama Configuration
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest
VECTOR_DIMENSION=768

# ============================================================================
# Search Configuration
# ============================================================================
SIMILARITY_THRESHOLD=0.7
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# ============================================================================
# Chunking Configuration
# ============================================================================
CHUNK_SIZE=2000
MIN_COMBINED_CONTENT_SIZE=100
MAX_COMBINED_CONTENT_SIZE=3500000

# ============================================================================
# Crawling Configuration
# ============================================================================
CRAWL_MAX_DEPTH=3
CRAWL_MAX_CONCURRENT=5

# ============================================================================
# AI Context Generation Configuration
# ============================================================================
# Model selection: format is "provider:model_name"
# Examples:
#   - "anthropic:claude-3-5-sonnet-20241022" (recommended)
#   - "anthropic:claude-3-opus-20250729"
#   - "openai:gpt-4-turbo"
#   - "openai:gpt-4o"
CONTEXT_AGENT_MODEL=anthropic:claude-3-5-sonnet-20241022

# Temperature controls randomness (0.0 = deterministic, 1.0 = very random)
# Lower values (0.1-0.3) recommended for context generation
CONTEXT_AGENT_TEMPERATURE=0.3

# Maximum tokens in context generation response
CONTEXT_AGENT_MAX_TOKENS=500

# Number of chunks to process in parallel
CONTEXT_BATCH_SIZE=10

# Enable prompt caching for cost optimization (true/false)
CONTEXT_ENABLE_CACHE=true

# API Keys (required for AI context generation)
# Get Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Get OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

