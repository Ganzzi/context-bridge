# Context Bridge Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection settings (used by config.py)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=context_bridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Connection pool settings
DB_POOL_MIN=1
DB_POOL_MAX=10

# Legacy Docker Compose variables (for compatibility)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=context_bridge
POSTGRES_PORT=5432

# ============================================================================
# Ollama Configuration
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest
VECTOR_DIMENSION=768
OLLAMA_HOST_VOLUME_PATH=Z:/Ollama

# ============================================================================
# Search Configuration
# ============================================================================
SIMILARITY_THRESHOLD=0.7
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# ============================================================================
# Crawling Configuration
# ============================================================================
CRAWL_MAX_DEPTH=3
CRAWL_MAX_PAGES=100
CRAWL_TIMEOUT=30.0
CRAWL_MAX_CONCURRENT=5
CRAWL_USER_AGENT=ContextBridge/0.1.0
CRAWL_RETRY_ATTEMPTS=3

# ============================================================================
# UI Configuration
# ============================================================================
UI_HOST=localhost
UI_PORT=8501
UI_THEME=dark
UI_ENABLE_METRICS=true

# ============================================================================
# MCP Server Configuration
# ============================================================================
MCP_SERVER_NAME=context_bridge
MCP_HOST=localhost
MCP_PORT=3000
MCP_TRANSPORT=stdio
MCP_LOG_LEVEL=info

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
