"""JSON schemas for MCP tool input/output validation."""

from typing import Any


# Input schemas
FIND_DOCUMENTS_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": ["query"],
    "properties": {
        "query": {"type": "string", "description": "Search query for document name/description"},
        "limit": {
            "type": "integer",
            "description": "Maximum results",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
        },
    },
}

SEARCH_CONTENT_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": ["query"],
    "properties": {
        "query": {"type": "string", "description": "Search query for content"},
        "document_id": {"type": "integer", "description": "Limit search to specific document"},
        "limit": {
            "type": "integer",
            "description": "Maximum results",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
        },
        "vector_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Weight for vector similarity",
        },
        "bm25_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Weight for BM25 score",
        },
    },
}


# Output schemas (for reference - not used directly in MCP)
DOCUMENT_INFO_SCHEMA: dict[str, Any] = {
    "type": "object",
    "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "version": {"type": "string"},
        "description": {"type": "string"},
        "source_url": {"type": "string"},
        "total_pages": {"type": "integer"},
        "total_chunks": {"type": "integer"},
        "created_at": {"type": "string", "format": "date-time"},
    },
    "required": [
        "id",
        "name",
        "version",
        "source_url",
        "total_pages",
        "total_chunks",
        "created_at",
    ],
}

SEARCH_RESULT_ITEM_SCHEMA: dict[str, Any] = {
    "type": "object",
    "properties": {
        "document_name": {"type": "string"},
        "document_version": {"type": "string"},
        "chunk_content": {"type": "string"},
        "page_url": {"type": "string"},
        "score": {"type": "number"},
        "rank": {"type": "integer"},
    },
    "required": ["document_name", "document_version", "chunk_content", "page_url", "score", "rank"],
}


# Tag-related input schemas
LIST_TAGS_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": [],
    "properties": {
        "category": {
            "type": "string",
            "description": "Filter by tag category (documentation_type, technology, domain, custom)",
            "enum": ["documentation_type", "technology", "domain", "custom"],
        },
    },
}

ADD_DOCUMENT_TAGS_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": ["document_id", "tag_ids"],
    "properties": {
        "document_id": {"type": "integer", "description": "ID of document to tag"},
        "tag_ids": {
            "type": "array",
            "items": {"type": "integer"},
            "description": "IDs of tags to add to document",
            "minItems": 1,
        },
    },
}

REMOVE_TAG_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": ["document_id", "tag_id"],
    "properties": {
        "document_id": {"type": "integer", "description": "ID of document"},
        "tag_id": {"type": "integer", "description": "ID of tag to remove"},
    },
}

UPDATE_FIND_DOCUMENTS_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": ["query"],
    "properties": {
        "query": {"type": "string", "description": "Search query for document name/description"},
        "tags": {
            "type": "array",
            "items": {"type": "integer"},
            "description": "Filter by tag IDs",
        },
        "tag_match_all": {
            "type": "boolean",
            "description": "Require all tags (AND) vs any tag (OR)",
            "default": False,
        },
        "limit": {
            "type": "integer",
            "description": "Maximum results",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
        },
    },
}


# Group management input schemas
LIST_GROUPS_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": [],
    "properties": {
        "document_id": {
            "type": "integer",
            "description": "Optional document ID to filter groups by document. If omitted, lists all groups.",
        },
        "limit": {
            "type": "integer",
            "description": "Maximum results",
            "minimum": 1,
            "maximum": 100,
            "default": 100,
        },
        "offset": {
            "type": "integer",
            "description": "Pagination offset",
            "minimum": 0,
            "default": 0,
        },
    },
}

GET_GROUP_STATUS_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": ["group_id"],
    "properties": {
        "group_id": {
            "type": "string",
            "description": "UUID of the group to retrieve status for",
        },
    },
}

# Context generation input schemas
GENERATE_CONTEXT_FOR_GROUP_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": ["group_id"],
    "properties": {
        "group_id": {
            "type": "string",
            "description": "UUID of the group to generate context for",
        },
        "context_model": {
            "type": "string",
            "description": "Optional LLM model override (format: provider:model_name, e.g., anthropic:claude-3-5-sonnet-20241022)",
        },
    },
}

LIST_NON_CONTEXT_GROUPS_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": [],
    "properties": {
        "document_id": {
            "type": "integer",
            "description": "Optional document ID to filter groups that need context generation",
        },
    },
}

# Re-processing input schemas
REPROCESS_GROUP_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": ["group_id"],
    "properties": {
        "group_id": {
            "type": "string",
            "description": "UUID of the group to reprocess with context generation",
        },
        "context_model": {
            "type": "string",
            "description": "Optional LLM model override (format: provider:model_name, e.g., anthropic:claude-3-5-sonnet-20241022)",
        },
    },
}

REPROCESS_MULTIPLE_GROUPS_INPUT_SCHEMA: dict[str, Any] = {
    "type": "object",
    "required": ["group_ids"],
    "properties": {
        "group_ids": {
            "type": "array",
            "items": {"type": "string"},
            "description": "List of group UUIDs to reprocess with context generation",
            "minItems": 1,
        },
        "context_model": {
            "type": "string",
            "description": "Optional LLM model override (format: provider:model_name, e.g., anthropic:claude-3-5-sonnet-20241022)",
        },
    },
}
