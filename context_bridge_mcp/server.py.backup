async def _handle_reprocess_group(
    bridge: ContextBridge, arguments: dict[str, Any]
) -> list[types.TextContent]:
    """Handle reprocess_group tool call."""
    try:
        # Extract parameters
        group_id = arguments.get("group_id")
        context_model = arguments.get("context_model")

        if not group_id:
            response = {
                "error": "group_id is required",
                "status": "failed",
            }
        else:
            # Reprocess group with context
            result = await bridge.reprocess_group_with_context(
                group_id=group_id,
                context_model=context_model,
            )

            # Convert UUID to string for JSON serialization
            if "group_id" in result and hasattr(result["group_id"], "__str__"):
                result["group_id"] = str(result["group_id"])

            response = {
                "status": "success",
                "result": result,
            }

        import json

        return [types.TextContent(type="text", text=json.dumps(response, indent=2))]
    except ValueError as e:
        logger.warning(f"Value error in reprocess_group: {e}")
        error_response = {
            "error": str(e),
            "status": "failed",
        }
        import json

        return [types.TextContent(type="text", text=json.dumps(error_response, indent=2))]
    except Exception as e:
        logger.error(f"Error executing reprocess_group: {e}", exc_info=True)
        error_response = {
            "error": f"Error executing reprocess_group: {str(e)}",
            "status": "failed",
        }
        import json

        return [types.TextContent(type="text", text=json.dumps(error_response, indent=2))]


async def _handle_reprocess_multiple_groups(
    bridge: ContextBridge, arguments: dict[str, Any]
) -> list[types.TextContent]:
    """Handle reprocess_multiple_groups tool call."""
    try:
        # Extract parameters
        group_ids = arguments.get("group_ids", [])
        context_model = arguments.get("context_model")

        if not group_ids:
            response = {
                "error": "group_ids is required and must be non-empty",
                "status": "failed",
                "results": [],
            }
        else:
            # Reprocess multiple groups with context
            result = await bridge.reprocess_multiple_groups_with_context(
                group_ids=group_ids,
                context_model=context_model,
            )

            # Convert UUIDs to strings for JSON serialization
            if "results" in result:
                for item in result["results"]:
                    if "group_id" in item and hasattr(item["group_id"], "__str__"):
                        item["group_id"] = str(item["group_id"])

            response = {
                "status": "success",
                "result": result,
            }

        import json

        return [types.TextContent(type="text", text=json.dumps(response, indent=2))]
    except ValueError as e:
        logger.warning(f"Value error in reprocess_multiple_groups: {e}")
        error_response = {
            "error": str(e),
            "status": "failed",
            "results": [],
        }
        import json

        return [types.TextContent(type="text", text=json.dumps(error_response, indent=2))]
    except Exception as e:
        logger.error(f"Error executing reprocess_multiple_groups: {e}", exc_info=True)
        error_response = {
            "error": f"Error executing reprocess_multiple_groups: {str(e)}",
            "status": "failed",
            "results": [],
        }
        import json

        return [types.TextContent(type="text", text=json.dumps(error_response, indent=2))]
